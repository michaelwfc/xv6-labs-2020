# debug for  kernel
# gdb-multiarch -x .gdbinit_kernel  kernel/kernel 

set confirm off
set architecture riscv:rv64
symbol-file kernel/kernel
set disassemble-next-line auto
set riscv use-compressed-breakpoints yes
set disassemble-next-line on
set print pretty on 
set print array on

target remote 127.0.0.1:26000
# debug for kernel/start.c
# b start
# debug for kernel/main:c scheduler
# b scheduler

# debug for echo in user space
# add-symbol-file user/_init
# b user/init.c:17

# add-symbol-file user/_sh
# b user/sh.c:147
# b getcmd
# add-symbol-file kernel/kernel kernel 0x80000000 -s trampoline 0x3ffffff000
# b uservec
# b *0x3ffffff000

# b uartputc
# b uartstart

# b usertrap
# set a break point in devintr on external interrupt
# b kernel/trap.c:186
# b uartintr

add-symbol-file user/_uthread 0x0
b uthread.c:184
b thread_create
b thread_switch
b thread_yield